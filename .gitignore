# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Ignore the server binary output by `go build` but not any folders with the name server
/server
!/server/

# Ignore the config and log files
keploy-config.yaml
keploy.yml
keploy-logs.txt


# Output of the go coverage tool, specifically when used with LiteIDE
*.out
.deploy.sh

### Go Patch ###
/vendor/
/Godeps/

# Dependency directories (remove the comment below to include it)
# vendor/
.idea/
web/public/*
!web/public/README.md
!web/public/index.html


.vscode
.env
ui

coverage.tmp.txt
coverage.txt
test-reports
.DS_Store
._.DS_Store
**/.DS_Store
**/._.DS_Store

#Ignore the zip files
*.zip

#Ignore the test reports
test-reports

#Ignore the test data
testdata

#Ignore the c and header files
*.c
*.h

# The Windows interception shim is an exception to the blanket *.c and *.dll
# rules above: it is C source that is committed, and a prebuilt DLL built from
# it that is committed too (the Windows release binaries are cross-compiled and
# cannot build C). Without these negations `git add` silently skips both, so a
# rebuild would look committed while the tree still carried the old asset.
!pkg/agent/hooks/winshim/shim/keploy_winshim.c
!pkg/agent/hooks/winshim/assets/keploy_winshim.dll

# Ignore the debug_bin
__debug_bin*
keploy
extraparsers.go
# fetched at build time by tools/fetchredirector, pinned in redirector.lock
pkg/agent/hooks/windows/libwindows_redirector.a
