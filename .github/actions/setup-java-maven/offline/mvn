#!/usr/bin/env bash
# mvn, as setup-java-maven puts it first on PATH after an exact hit of its
# cache: the job's own Maven, run offline.
#
# An exact hit is a cache a passing job saved under the same key: the same
# Maven, JDK, poms and Maven configuration (maven-cache-key.sh), so the same
# dependency set, all of which that job's build resolved. Such a cache serves
# the build with no network. If it does not, its key is missing something
# the build depends on, and the build fails here, naming that key, instead of
# fetching the cache's contents from Maven Central again on every run (which
# is how a cache saved by Maven 3.10.0 and restored for Maven 3.9.15 went
# unnoticed until Central answered 429).
#
# SETUP_JAVA_MAVEN_REAL_MVN: the mvn this shadows. SETUP_JAVA_MAVEN_CACHE_KEY:
# the key the cache was restored from. Both are set by the action.
real=${SETUP_JAVA_MAVEN_REAL_MVN:?SETUP_JAVA_MAVEN_REAL_MVN is not set}
key=${SETUP_JAVA_MAVEN_CACHE_KEY:?SETUP_JAVA_MAVEN_CACHE_KEY is not set}
rc=0
"$real" --offline "$@" || rc=$?
if [ "$rc" -ne 0 ]; then
  echo "::error title=Maven failed offline on its restored cache::mvn exited $rc. It ran offline because ~/.m2/repository was restored from the exact cache key $key. If Maven says an artifact \"has not been downloaded from it before\" or that it cannot reach a repository in offline mode, that cache cannot serve this build: the key is missing something the build depends on (see .github/actions/setup-java-maven/maven-cache-key.sh)." >&2
fi
exit "$rc"
